# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application Environment
NODE_ENV=development
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
DATABASE_URL=postgresql://taskflow_user:taskflow_password@localhost:5432/taskflow_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow_db
DB_USER=taskflow_user
DB_PASSWORD=taskflow_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Flask Secret Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000

# Email Configuration (for production)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads

# ML Model Configuration
MODEL_PATH=ml-models/
MODEL_UPDATE_INTERVAL=24  # hours

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/taskflow.log

# Security
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
WTF_CSRF_ENABLED=True

# API Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Development Database Credentials
PGADMIN_DEFAULT_EMAIL=admin@taskflow.dev
PGADMIN_DEFAULT_PASSWORD=admin